    { "dot": "emerald", "title": "Inside a cassette (schema v1)", "items": [
      "session: one row, command, mode, status, parent session",
      "interactions: raw HTTP exchanges, used to replay",
      "chunks: SSE events with their time offset",
      "events: semantic log (model_response, tool_call...), used to diff",
      "blobs: bodies stored once by SHA-256"
    ] },
    { "dot": "cyan", "title": "Replay modes (retrace run)", "items": [
      "exact: both channels from the cassette, no network",
      "swap-model: real LLM with another model, tools from cassette",
      "live-tools: LLM from cassette, real MCP servers",
      "A request with no recorded match is a divergence (strict)",
      "Every replay writes a new cassette; the source is never modified"
    ] },
