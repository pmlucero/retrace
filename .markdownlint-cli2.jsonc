{
  // Markdown lint configuration, enforced in CI (.github/workflows/docs.yml).
  "config": {
    "default": true,
    // Prose is not hard-wrapped.
    "MD013": false,
    // ADRs repeat "Positive" / "Negative" under different parents.
    "MD024": { "siblings_only": true },
    // <picture> is the only way to serve a light and a dark diagram on GitHub.
    "MD033": { "allowed_elements": ["picture", "source", "img"] }
  },
  "ignores": [
    "node_modules/**",
    // Vendored text (Contributor Covenant), kept verbatim.
    "CODE_OF_CONDUCT.md",
    // Starts with H2 by design: GitHub inserts it under the PR title.
    ".github/pull_request_template.md"
  ]
}
